APP_NAME="Scholarship Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=scholarship_web
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
PRIVACY_CONTACT_EMAIL="scholarshipfinder@email.com"
RETENTION_READ_NOTIFICATIONS_DAYS=365
RETENTION_ACTIVITY_LOGS_DAYS=730

PLATFORM_BACKUP_ENABLED=false
# PLATFORM_BACKUP_PATH=storage/app/backups
# MYSQL_BINARY=/path/to/mysql
PLATFORM_BACKUP_RETENTION_DAYS=14
PLATFORM_BACKUP_PRIVATE_FILES=true
PLATFORM_BACKUP_PUBLIC_FILES=true
MYSQLDUMP_BINARY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PROVIDER_BILLING_ENABLED=false
PAYMONGO_BASE_URL=https://api.paymongo.com
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_PAYMENT_METHODS=card,gcash,qrph
PAYMONGO_SIGNATURE_TOLERANCE=300
PROVIDER_ASSISTED_SETUP_AMOUNT=75000
PROVIDER_CYCLE_SUPPORT_AMOUNT=250000
PROVIDER_INTEGRATION_CONSULTATION_AMOUNT=150000
MOBILE_TOKEN_LIFETIME_DAYS=30

ADMIN_EMAIL=admin@scholarship.test
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password123
