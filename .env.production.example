APP_NAME="Scholarship Portal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_secure_database_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.your-mail-provider.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"
PRIVACY_CONTACT_EMAIL="privacy@your-domain.com"

RETENTION_READ_NOTIFICATIONS_DAYS=365
RETENTION_ACTIVITY_LOGS_DAYS=730

# Use a protected path outside the public web root, preferably on a separate mounted disk.
PLATFORM_BACKUP_ENABLED=true
PLATFORM_BACKUP_PATH=/var/backups/scholarship-portal
# MYSQL_BINARY=/usr/bin/mysql
PLATFORM_BACKUP_RETENTION_DAYS=14
PLATFORM_BACKUP_PRIVATE_FILES=true
PLATFORM_BACKUP_PUBLIC_FILES=true
MYSQLDUMP_BINARY=/usr/bin/mysqldump

VITE_APP_NAME="${APP_NAME}"
MOBILE_TOKEN_LIFETIME_DAYS=30

# Optional provider services. Keep disabled until live PayMongo keys and the webhook are configured.
PROVIDER_BILLING_ENABLED=false
PAYMONGO_BASE_URL=https://api.paymongo.com
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_PAYMENT_METHODS=card,gcash,qrph
PAYMONGO_SIGNATURE_TOLERANCE=300
PROVIDER_ASSISTED_SETUP_AMOUNT=75000
PROVIDER_CYCLE_SUPPORT_AMOUNT=250000
PROVIDER_INTEGRATION_CONSULTATION_AMOUNT=150000

ADMIN_EMAIL=admin@your-domain.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-seeding
