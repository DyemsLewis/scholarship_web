Options -Indexes

<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never expose application internals, even with public_html as the document root.
    RewriteRule ^(?:app|bootstrap|config|database|deploy|node_modules|resources|routes|storage|tests|vendor)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:artisan|composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml|vite\.config\.[^/]+)$ - [F,L,NC]
    RewriteRule ^(?:public/)?uploads/.*\.(?:php[0-9]?|phtml|phar|cgi|pl|py|sh)(?:/|$) - [F,L,NC]

    # Hostinger Web and Cloud plans use public_html as a fixed document root.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
